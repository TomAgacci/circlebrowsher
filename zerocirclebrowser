#!/bin/sh
# Zero Circle Math Browser
# HTML4-only terminal browser with navigation, ANSI SMPTE bars, GIF pulse, JPG/BMP support

FILE="$1"
if [ -z "$FILE" ]; then
  echo "Usage: $0 file.html"
  exit 1
fi

while true; do
  clear
  echo "=== Zero Circle Math Browser ==="
  echo "Rendering: $FILE"
  echo

  # SMPTE ANSI color bars (simulate NTSC test screen)
  echo "SMPTE Bars:"
  echo -e "\033[47m   \033[43m   \033[46m   \033[42m   \033[45m   \033[41m   \033[44m   \033[0m"
  echo

  # Parse HTML4: show text, links, images
  awk '
  BEGIN { IGNORECASE=1; linknum=1 }
  /<a href=/ {
    match($0, /href="([^"]+)"/, arr)
    if(arr[1]!="") {
      printf("\033[36m[%d] LINK:\033[0m %s\n", linknum, arr[1])
      linknum++
    }
  }
  /<img src=/ {
    match($0, /src="([^"]+)"/, arr)
    if(arr[1] ~ /\.gif$/) {
      print "\033[35m[GIF Pulse]\033[0m " arr[1]
    } else if(arr[1] ~ /\.jpe?g$/) {
      print "\033[32m[JPG Texture]\033[0m " arr[1]
    } else if(arr[1] ~ /\.bmp$/) {
      print "\033[34m[BMP Texture]\033[0m " arr[1]
    }
  }
  {
    gsub(/<[^>]+>/,"")
    if(length($0)>0) print $0
  }
  ' "$FILE"

  echo
  echo "Options:"
  echo "  Enter link number to follow"
  echo "  q = quit"
  echo

  # GIF pulse animation
  for i in 1 2 3; do
    echo -ne "\033[35mGIF pulse frame $i ▒▓█\033[0m\r"
    sleep 0.3
  done
  echo

  read -p "Choice: " choice
  if [ "$choice" = "q" ]; then
    break
  fi

  # Navigate to chosen link (local file only)
  if [ -n "$choice" ]; then
    FILE=$(awk -v n="$choice" '
      BEGIN { IGNORECASE=1; linknum=1 }
      /<a href=/ {
        match($0, /href="([^"]+)"/, arr)
        if(arr[1]!="" && linknum==n) { print arr[1]; exit }
        linknum++
      }
    ' "$FILE")
    if [ -z "$FILE" ]; then
      echo "Invalid choice."
      exit 1
    fi
  fi
done
