#!/usr/bin/env sh
# zc_img_project.sh
# Real image projection in terminal (pure sh, no awk)
# Requires: ImageMagick "convert"

IMG="$1"
[ -z "$IMG" ] && { echo "Usage: $0 image.png" >&2; exit 1; }

# 1) Get terminal size (ROWS COLS) without awk in the main loop
set -- $(stty size 2>/dev/null)
ROWS="$1"
COLS="$2"
[ -z "$ROWS" ] && ROWS=24
[ -z "$COLS" ] && COLS=80

PIX_W="$COLS"
PIX_H="$ROWS"

# 2) Decode image → raw RGB bytes, exactly PIX_W x PIX_H
#    convert outputs binary RGB; od turns it into "r g b" triples
if ! command -v convert >/dev/null 2>&1; then
  echo "Need ImageMagick 'convert' installed." >&2
  exit 1
fi

TMP="${TMPDIR:-/tmp}/zc_rgb_$$.txt"

convert "$IMG" -resize "${PIX_W}x${PIX_H}!" -depth 8 rgb:- 2>/dev/null \
  | od -An -tu1 -w3 -v \
  | sed 's/^ *//' > "$TMP"

# 3) Project: each terminal cell = one colored pixel
clear
count=0
line=""

while IFS=' ' read -r r g b; do
  [ -z "$r" ] && continue
  line="$line$(printf '\033[38;2;%s;%s;%sm█' "$r" "$g" "$b")"
  count=$((count + 1))

  if [ "$count" -eq "$PIX_W" ]; then
    printf '%s\033[0m\n' "$line"
    line=""
    count=0
  fi
done < "$TMP"

# flush any partial line
[ -n "$line" ] && printf '%s\033[0m\n' "$line"

rm -f "$TMP"


